{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo.webosbrew.org/schemas/conf/Home.json",
  "title": "Home",
  "description": "Apps featured on the homepage (conf/home.yml)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "featured": {
      "type": "array",
